NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Solo servidor. No usar prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# HU-23: opcionales. Vacías mantienen la ubicación manual sin llamadas a Google Maps.
# Clave de navegador restringida a dominios + Maps JavaScript API / Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Clave de navegador separada, restringida a dominios + Maps Embed API.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
