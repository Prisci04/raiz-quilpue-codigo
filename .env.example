NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Solo servidor. No usar prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# HU-23: sin credenciales. Opcionales para sustituir los proveedores OSM.
# En Vercel, configurar una pasarela con limitación global o un proveedor apropiado.
NOMINATIM_SEARCH_URL=
# Solo en un servidor propio de un único proceso/instancia; no habilita Nominatim público en Vercel.
NOMINATIM_SINGLE_INSTANCE=
# Por defecto: https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_OSM_TILE_URL=

# HU-22: servidor. Mock no realiza llamadas externas de IA.
AI_PROVIDER=mock
# Producción/Vercel: aplicar SQL 020 manualmente y usar supabase.
# Desarrollo sin migración: AI_STORAGE=local (archivo ignorado, un solo proceso).
# Sin variable: supabase en producción, local en desarrollo. No hay fallback silencioso.
AI_STORAGE=supabase
QWEN_API_KEY=
# Base HTTPS oficial de la región/workspace; termina en /compatible-mode/v1.
QWEN_BASE_URL=
# Modelo de texto con system messages, enable_thinking=false y max_completion_tokens.
QWEN_MODEL=
